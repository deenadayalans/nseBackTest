# Copy this file to .env and fill in your values.
# .env is in .gitignore — never commit real secrets.

# ── Zerodha Kite Connect ──────────────────────────────────────────────────────
# Get these from: https://developers.kite.trade/ → My Apps → Create App
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Filled in automatically by login.py each morning (valid until midnight IST)
KITE_ACCESS_TOKEN=

# ── LLM (optional) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
LLM_MODE=claude         # "claude" or "ollama"
OLLAMA_MODEL=llama3     # only used when LLM_MODE=ollama
