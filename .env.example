# ── Zerodha Kite Connect ──────────────────────────────────────────────────────
# Get from: https://developers.kite.trade/  → My Apps
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_ACCESS_TOKEN=                    # filled automatically by start.py each morning

# ── Telegram alerts (recommended — instant, free) ─────────────────────────────
# Setup (2 min):
#   1. Open Telegram → search @BotFather → /newbot → follow prompts → copy token
#   2. Open your new bot → press Start
#   3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates → find "chat":{"id":XXXXX}
TG_BOT_TOKEN=
TG_CHAT_ID=

# ── WhatsApp alerts via CallMeBot (optional backup) ───────────────────────────
# Register: save +34 644 59 77 31 as contact → WhatsApp: "I allow callmebot to send me messages"
WA_PHONE=+91XXXXXXXXXX
WA_APIKEY=

# ── Trade sizing ──────────────────────────────────────────────────────────────
INITIAL_CAPITAL=200000    # ₹2 Lakhs starting capital
DEPLOY_PCT=0.20           # 20% of equity deployed per trade
MAX_LOTS_NIFTY=10         # hard cap on Nifty lots
MAX_LOTS_SENSEX=20        # hard cap on Sensex lots
